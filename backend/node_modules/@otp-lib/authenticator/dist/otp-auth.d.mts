import { IOTPOptions, OTP, HashAlgorithms, Secret, HOTP, IHOTPOptions, TOTP, ITOTPOptions } from '@otp-lib/core';
export { HashAlgorithms, Secret } from '@otp-lib/core';

type TAuthenticatorOptions<T extends IOTPOptions> = T & IAuthenticatorOptions;
/**
 * Interface IAuthenticatorOptions
 * used to represents the authenticator options
 *
 * @export
 * @interface IAuthenticatorOptions
 * @extends {IOTPOptions}
 */
interface IAuthenticatorOptions {
    /**
     * The issuer name of authenticator
     *
     * @type {string}
     * @memberof IAuthenticatorOptions
     */
    issuer?: string;
    /**
     * The account name of authenticator
     *
     * @type {string}
     * @memberof IAuthenticatorOptions
     */
    account: string;
}

/**
 * Class Authenticator
 * used to implements the authenticator
 *
 * @class Authenticator
 * @template TCore The template of OTP
 * @template TOptions The template of OTP options
 */
declare class Authenticator<TCore extends OTP, TOptions extends IOTPOptions> {
    /**
     * The account name of authenticator
     *
     * @private
     * @type {string}
     * @memberof Authenticator
     */
    private account;
    /**
     * The issuer name of authenticator
     *
     * @private
     * @type {(string | null)}
     * @memberof Authenticator
     */
    private issuer;
    /**
     * The OTP of authenticator
     *
     * @protected
     * @type {TCore}
     * @memberof Authenticator
     */
    protected otp: TCore;
    /**
     * Constructor of Authenticator class
     *
     * @param {TCore} otp The instance of OTP
     * @param {TAuthenticatorOptions<TOptions>} options The options of authenticator
     * @memberof Authenticator
     */
    constructor(otp: TCore, options: TAuthenticatorOptions<TOptions>);
    /**
     * Get the hash algorithm of OTP authenticator
     *
     * @return {HashAlgorithms}
     * @memberof Authenticator
     */
    getAlgorithm(): HashAlgorithms;
    /**
     * Get the digits length of OTP authenticator
     *
     * @return {number}
     * @memberof Authenticator
     */
    getDigits(): number;
    /**
     * Get the secret of OTP authenticator
     *
     * @return {Secret}
     * @memberof Authenticator
     */
    getSecret(): Secret;
    /**
     * Get the account name of authenticator
     *
     * @return {string}
     * @memberof Authenticator
     */
    getAccount(): string;
    /**
     * Get the issuer name of authenticator
     *
     * @return {(string | null)}
     * @memberof Authenticator
     */
    getIssuer(): string | null;
    /**
     * Get the authenticator options from URL
     *
     * @protected
     * @static
     * @param {URL} url The authenticator URI to parse
     * @return {TAuthenticatorOptions<IOTPOptions>}
     * @memberof Authenticator
     */
    protected static fromURL(url: URL): TAuthenticatorOptions<IOTPOptions>;
    /**
     * Get the URL from authenticator
     *
     * @protected
     * @return {URL}
     * @memberof Authenticator
     */
    protected toURL(): URL;
}

/**
 * Class HOTPAuthenticator
 * used to implements the HMAC-Based One-Time Password Authenticator
 *
 * @class HOTPAuthenticator
 * @extends {Authenticator<HOTP, IHOTPOptions>}
 */
declare class HOTPAuthenticator extends Authenticator<HOTP, IHOTPOptions> {
    /**
     * Constructor of HOTPAuthenticator class
     *
     * @param {TAuthenticatorOptions<IHOTPOptions>} options The options of HOTP
     * @memberof HOTPAuthenticator
     */
    constructor(options: TAuthenticatorOptions<IHOTPOptions>);
    /**
     * Set the counter value of HOTP authenticator
     *
     * @param {number} counter The counter value of HOTP authenticator
     * @memberof HOTPAuthenticator
     */
    setCounter(counter: number): void;
    /**
     * Get the look-ahead window of HOTP authenticator
     *
     * @return {number}
     * @memberof HOTPAuthenticator
     */
    getLookAhead(): number;
    /**
     * Get the counter value of HOTP authenticator
     *
     * @return {number}
     * @memberof HOTPAuthenticator
     */
    getCounter(): number;
    /**
     * Generate the HOTP code from current counter value
     *
     * @return {Promise<string>}
     * @memberof HOTPAuthenticator
     */
    generate(): Promise<string>;
    /**
     * Verify the HOTP code delta for the current counter value
     *
     * @param {string} code The HOTP code to verify
     * @return {Promise<number | null>}
     * @memberof HOTPAuthenticator
     */
    verifyDelta(code: string): Promise<number | null>;
    /**
     * Verify if the HOTP code is valid for the current counter value
     *
     * @param {string} code The HOTP code to verify
     * @return {Promise<boolean>}
     * @memberof HOTPAuthenticator
     */
    verify(code: string): Promise<boolean>;
    /**
     * Get the HOTP authenticator from URI
     *
     * @static
     * @param {string} uri The HOTP URI to parse
     * @return {HOTPAuthenticator}
     * @memberof HOTPAuthenticator
     */
    static fromURI(uri: string): HOTPAuthenticator;
    /**
     * Get the URI of HOTP authenticator
     *
     * @return {string}
     * @memberof HOTPAuthenticator
     */
    toURI(): string;
}

/**
 * Class TOTPAuthenticator
 * used to implements the Time-Based One-Time Password Authenticator
 *
 * @class TOTPAuthenticator
 * @extends {Authenticator<TOTP, ITOTPOptions>}
 */
declare class TOTPAuthenticator extends Authenticator<TOTP, ITOTPOptions> {
    /**
     * Constructor of TOTPAuthenticator class
     *
     * @param {TAuthenticatorOptions<ITOTPOptions>} options The options of TOTP
     * @memberof TOTPAuthenticator
     */
    constructor(options: TAuthenticatorOptions<ITOTPOptions>);
    /**
     * Get the past, future period window of TOTP authenticator
     *
     * @return {number}
     * @memberof TOTPAuthenticator
     */
    getWindow(): [number, number];
    /**
     * Get the period in seconds of TOTP authenticator
     *
     * @return {number}
     * @memberof TOTPAuthenticator
     */
    getPeriod(): number;
    /**
     * Get the counter of TOTP authenticator
     *
     * @return {number}
     * @memberof TOTPAuthenticator
     */
    getCounter(): number;
    /**
     * Get the number of seconds used in the current time step
     *
     * @return {number}
     * @memberof TOTPAuthenticator
     */
    getTimeUsed(): number;
    /**
     * Get the remaining time in seconds until the next time step
     *
     * @return {number}
     * @memberof TOTPAuthenticator
     */
    getTimeRemaining(): number;
    /**
     * Generate the TOTP code from current counter time step
     *
     * @return {Promise<string>}
     * @memberof TOTPAuthenticator
     */
    generate(): Promise<string>;
    /**
     * Verify the TOTP code delta for the current counter value
     *
     * @param {string} code The TOTP code to verify
     * @return {Promise<number | null>}
     * @memberof TOTPAuthenticator
     */
    verifyDelta(code: string): Promise<number | null>;
    /**
     * Verify if the TOTP code is valid for the current counter value
     *
     * @param {string} code The TOTP code to verify
     * @return {Promise<boolean>}
     * @memberof TOTPAuthenticator
     */
    verify(code: string): Promise<boolean>;
    /**
     * Get the TOTP authenticator from URI
     *
     * @static
     * @param {string} uri The TOTP URI to parse
     * @return {TOTPAuthenticator}
     * @memberof TOTPAuthenticator
     */
    static fromURI(uri: string): TOTPAuthenticator;
    /**
     * Get the URI of TOTP
     *
     * @return {string}
     * @memberof TOTPAuthenticator
     */
    toURI(): string;
}

/**
 * Enum AuthenticatorType
 * used to implements the authenticator type
 *
 * @export
 * @enum {string}
 * @see https://github.com/google/google-authenticator/wiki/Key-Uri-Format#types
 */
declare enum AuthenticatorType {
    /**
     * The HOTP type of authenticator
     *
     * @type {string}
     */
    HOTP = "hotp",
    /**
     * The TOTP type of authenticator
     *
     * @type {string}
     */
    TOTP = "totp"
}

export { Authenticator, AuthenticatorType, HOTPAuthenticator as HOTP, type IAuthenticatorOptions, type TAuthenticatorOptions, TOTPAuthenticator as TOTP };
